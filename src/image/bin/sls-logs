#!/usr/bin/env bash
# Collects SystemLink Server and Windows logs from the guest (Collect-Logs.ps1 through sls-exec) plus the container-side
# agent, install and seal files (and a bugcheck's sls-panic.txt/.ppm) into /shared/logs/<timestamp> (linked as
# /shared/logs/latest) and writes a .tgz.
#   docker exec <c> sls-logs -o /tmp/sls-logs.tgz && docker cp <c>:/tmp/sls-logs.tgz .
#   docker exec <c> sls-logs > sls-logs.tgz          (bash and PowerShell 7.4+; older PowerShell corrupts binary pipes)
#   -t seconds  guest collection timeout (default 600); -n  no archive, only the folder
# Without a running guest agent, or after a Windows bugcheck, only the container-side files are archived. Progress
# goes to stderr.
set -u
usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; }
outf=-
timeout=600
archive=1
while getopts o:t:nh o; do
  case $o in
    o) outf=$OPTARG ;;
    t) timeout=$OPTARG ;;
    n) archive=0 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [ "$archive" -eq 1 ] && [ "$outf" = "-" ] && [ -t 1 ]; then
  echo "sls-logs: refusing to write an archive to a terminal (use -o <file>, redirect stdout, or -n)" >&2
  exit 2
fi

name=$(date -u +%Y%m%d-%H%M%S)
dir=/shared/logs/$name
mkdir -p "$dir"
log() { echo "sls-logs: $*" >&2; }

if [ -e "${STORAGE:-/storage}/sls-panic.txt" ]; then
  # boot.json survives a bugcheck; the paused guest would only run out the timeout.
  log "Windows bugcheck ($(cat "${STORAGE:-/storage}/sls-panic.txt")): container-side files only"
elif [ -s /shared/agent/boot.json ]; then
  log "collecting guest logs (timeout ${timeout}s)"
  sls-exec -t "$timeout" -c "& 'C:\\sls\\guest\\Collect-Logs.ps1' -Name '$name'" >&2
  rc=$?
  [ "$rc" -eq 0 ] || log "guest collection exit $rc"
else
  log "guest agent not running: container-side files only"
fi

for d in agent install seal; do
  [ -d "/shared/$d" ] && cp -r "/shared/$d" "$dir/container-$d" 2>/dev/null
done
cp "${STORAGE:-/storage}"/sls-panic.txt "${STORAGE:-/storage}"/sls-panic.ppm "$dir/" 2>/dev/null
{
  echo "collected: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "SLS_CONFIG=${SLS_CONFIG:-}"
  echo "guest ip: $(cat /run/shm/qemu.ip 2>/dev/null)"
} >"$dir/container.txt"
ln -sfn "$name" /shared/logs/latest

if [ "$archive" -eq 1 ]; then
  if [ "$outf" = "-" ]; then
    tar -C /shared/logs -czf - "$name"
  else
    tar -C /shared/logs -czf "$outf" "$name" && log "archive: $outf ($(du -h "$outf" | cut -f1))"
  fi
else
  log "folder: $dir"
fi
